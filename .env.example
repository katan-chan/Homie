# Local backend: npm run dev:backend
PORT=3001
FRONTEND_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Vercel: set this in Project Settings > Environment Variables, then redeploy.
# Public URL only; never put credentials here.
PUBLIC_API_BASE_URL=http://localhost:3001
# Vị trí: Esri ArcGIS Location Platform keys (free tier, never enable pay-as-you-go).
# Basemap key reaches the browser: give it basemap access only and restrict it to the site's referrers.
PUBLIC_ESRI_BASEMAP_KEY=
# Routing key stays on the backend (Render).
ESRI_ROUTE_KEY=

# Server-only salted hashes, never plaintext; see docs/authentication.md.
MINHLE_PASSWORD_HASH=
HAIYEN_PASSWORD_HASH=
PROFILE_DATA_DIR=.data
SESSION_SAME_SITE=Lax

# Durable storage on Supabase (server-only). When both are set, profiles, notes and
# note images go to Supabase instead of PROFILE_DATA_DIR. Never use the secret key in frontend.
# Note: setting these locally makes `npm run dev:backend` read/write the real project.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Phone notifications: Firebase service account key (one-line JSON or base64). Empty = no notifications are sent.
FIREBASE_SERVICE_ACCOUNT=
